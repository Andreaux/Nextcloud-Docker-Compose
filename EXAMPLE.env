DOMAINNAME=example.domain.com
REDIS_PASSWORD=YourSecureRedisPasswordHere
MYSQL_ROOT_PASSWORD=YourSecureMariaDBPasswordHere
MYSQL_PASSWORD=YourSecureNextcloudPasswordHere
COLLABORA_PASSWORD=YourSecureCollaboraPasswordHere
ESCAPED_COLLABORA_DOMAINNAME=nextcloud\.example\.domain\.com|example\.domain\.com
HP_SHARED_KEY=YourSecureHaRPKeyHere
WHITEBOARD_JWT_SECRET=YourWhiteboardJWTSecretKey
# Optional services. Uncomment to enable the Talk High-performance backend (see README.md).
#COMPOSE_PROFILES=talk-hpb
TALK_TURN_SECRET=YourTalkTURNSecretHere
TALK_SIGNALING_SECRET=YourTalkSignalingSecretHere
TALK_INTERNAL_SECRET=YourTalkInternalSecretHere
# Host port for Talk signaling (NPM forwards to it). Defaults to 8081 if not set.
#TALK_SIGNALING_PORT=8081